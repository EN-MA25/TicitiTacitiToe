<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".game.ui.GameActivity"
    android:background="@drawable/comic_style_bg_red_blue">

    <GridLayout
        android:id="@+id/boardGrid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="3"
        android:padding="8dp"
        android:background="@color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        >

        <ImageButton
            android:id="@+id/cell00"
            android:layout_width="@dimen/cell_size"
            android:layout_height="@dimen/cell_size"
            android:background="@drawable/cell_o"
            android:layout_margin="4dp"
            android:onClick="squarePressed"
            android:scaleType="fitCenter"
            android:tag="0,0" />

        <ImageButton
            android:id="@+id/cell01"
            android:layout_width="@dimen/cell_size"
            android:layout_height="@dimen/cell_size"
            android:background="@drawable/cell_x"
            android:layout_margin="4dp"
            android:onClick="squarePressed"
            android:scaleType="fitCenter"
            android:tag="0,1" />

        <ImageButton
            android:id="@+id/cell02"
            android:layout_width="@dimen/cell_size"
            android:layout_height="@dimen/cell_size"
            android:background="@drawable/cell_empty"
            android:layout_margin="4dp"
            android:onClick="squarePressed"
            android:scaleType="fitCenter"
            android:tag="0,2" />


        <ImageButton
            android:id="@+id/cell10"
            android:layout_width="@dimen/cell_size"
            android:layout_height="@dimen/cell_size"
            android:background="@drawable/cell_empty"
            android:layout_margin="4dp"
            android:onClick="squarePressed"
            android:scaleType="fitCenter"
            android:tag="1,0" />

        <ImageButton
            android:id="@+id/cell11"
            android:layout_width="@dimen/cell_size"
            android:layout_height="@dimen/cell_size"
            android:background="@drawable/cell_empty"
            android:layout_margin="4dp"
            android:onClick="squarePressed"
            android:scaleType="fitCenter"
            android:tag="1,1" />

        <ImageButton
            android:id="@+id/cell12"
            android:layout_width="@dimen/cell_size"
            android:layout_height="@dimen/cell_size"
            android:background="@drawable/cell_empty"
            android:layout_margin="4dp"
            android:onClick="squarePressed"
            android:scaleType="fitCenter"
            android:tag="1,2" />

        <ImageButton
            android:id="@+id/cell20"
            android:layout_width="@dimen/cell_size"
            android:layout_height="@dimen/cell_size"
            android:background="@drawable/cell_empty"
            android:layout_margin="4dp"
            android:onClick="squarePressed"
            android:scaleType="fitCenter"
            android:tag="2,0" />

        <ImageButton
            android:id="@+id/cell21"
            android:layout_width="@dimen/cell_size"
            android:layout_height="@dimen/cell_size"
            android:background="@drawable/cell_empty"
            android:layout_margin="4dp"
            android:onClick="squarePressed"
            android:scaleType="fitCenter"
            android:tag="2,1" />

        <ImageButton
            android:id="@+id/cell22"
            android:layout_width="@dimen/cell_size"
            android:layout_height="@dimen/cell_size"
            android:background="@drawable/cell_empty"
            android:layout_margin="4dp"
            android:onClick="squarePressed"
            android:scaleType="fitCenter"
            android:tag="2,2" />
    </GridLayout>

    <TextView
        android:id="@+id/status_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text=""
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/new_game_button"
        android:layout_width="250dp"
        android:layout_height="150dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/comic_text_bubble_400_350"
        android:fontFamily="@font/permanent_marker"
        android:onClick="playAgainPressed"
        android:text="Play again?"
        app:layout_constraintBottom_toTopOf="@+id/status_text_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="invisible"
        />


</androidx.constraintlayout.widget.ConstraintLayout>