<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".profile.FriendFragment"
    android:background="@drawable/bg_gradient_yellow_orange">

    <TextView
        android:id="@+id/friends_text_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/friends_"
        android:fontFamily="@font/comic_neue_bold_italic"
        android:background="@color/white"
        android:layout_marginTop="@dimen/_40dp"
        android:layout_marginHorizontal="@dimen/_20dp"
        app:layout_constraintTop_toTopOf="parent"
        />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/friends_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/_20dp"
        tools:listitem="@layout/user_list_item"
        app:layout_constraintTop_toBottomOf="@id/friends_text_view"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>