<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".onlinegame.OnlineGameActivity"
    android:background="@drawable/comic_style_bg_red_blue">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/boardContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintBottom_toTopOf="@id/chat_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/online_status_text_view"
        app:layout_constraintVertical_weight="2"
        app:layout_constraintVertical_chainStyle="spread_inside"
        app:layout_constraintVertical_bias="0.5">

        <ImageButton
            android:id="@+id/onlinecell00"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/cell_empty"
            android:layout_margin="4dp"
            android:onClick="squarePressed"
            android:scaleType="fitCenter"
            android:tag="0,0"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/onlinecell01"
            app:layout_constraintBottom_toTopOf="@id/onlinecell10"
            android:contentDescription="@string/game_cell"/>

        <ImageButton
            android:id="@+id/onlinecell01"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/cell_empty"
            android:layout_margin="4dp"
            android:onClick="squarePressed"
            android:scaleType="fitCenter"
            android:tag="0,1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/onlinecell02"
            app:layout_constraintStart_toEndOf="@id/onlinecell00"
            app:layout_constraintBottom_toTopOf="@id/onlinecell11"
            android:contentDescription="@string/game_cell"/>

        <ImageButton
            android:id="@+id/onlinecell02"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/cell_empty"
            android:layout_margin="4dp"
            android:onClick="squarePressed"
            android:scaleType="fitCenter"
            android:tag="0,2"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/onlinecell01"
            app:layout_constraintBottom_toTopOf="@id/onlinecell12"
            android:contentDescription="@string/game_cell"/>


        <ImageButton
            android:id="@+id/onlinecell10"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/cell_empty"
            android:layout_margin="4dp"
            android:onClick="squarePressed"
            android:scaleType="fitCenter"
            android:tag="1,0"
            app:layout_constraintTop_toBottomOf="@id/onlinecell00"
            app:layout_constraintBottom_toTopOf="@id/onlinecell20"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/onlinecell11"
            android:contentDescription="@string/game_cell"/>

        <ImageButton
            android:id="@+id/onlinecell11"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/cell_empty"
            android:layout_margin="4dp"
            android:onClick="squarePressed"
            android:scaleType="fitCenter"
            android:tag="1,1"
            app:layout_constraintTop_toBottomOf="@id/onlinecell01"
            app:layout_constraintStart_toEndOf="@id/onlinecell10"
            app:layout_constraintEnd_toStartOf="@id/onlinecell12"
            app:layout_constraintBottom_toTopOf="@id/onlinecell21"
            android:contentDescription="@string/game_cell"/>

        <ImageButton
            android:id="@+id/onlinecell12"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/cell_empty"
            android:layout_margin="4dp"
            android:onClick="squarePressed"
            android:scaleType="fitCenter"
            android:tag="1,2"
            app:layout_constraintTop_toBottomOf="@id/onlinecell02"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/onlinecell11"
            app:layout_constraintBottom_toTopOf="@id/onlinecell21"
            android:contentDescription="@string/game_cell"/>

        <ImageButton
            android:id="@+id/onlinecell20"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/cell_empty"
            android:layout_margin="4dp"
            android:onClick="squarePressed"
            android:scaleType="fitCenter"
            android:tag="2,0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/onlinecell21"
            app:layout_constraintTop_toBottomOf="@id/onlinecell10"
            app:layout_constraintBottom_toBottomOf="parent"
            android:contentDescription="@string/game_cell"/>

        <ImageButton
            android:id="@+id/onlinecell21"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="4dp"
            android:background="@drawable/cell_empty"
            android:contentDescription="@string/game_cell"
            android:onClick="squarePressed"
            android:scaleType="fitCenter"
            app:layout_constraintStart_toEndOf="@id/onlinecell20"
            app:layout_constraintEnd_toStartOf="@id/onlinecell22"
            app:layout_constraintTop_toBottomOf="@id/onlinecell11"
            app:layout_constraintBottom_toBottomOf="parent"
            android:tag="2,1" />

        <ImageButton
            android:id="@+id/onlinecell22"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/cell_empty"
            android:layout_margin="4dp"
            android:onClick="squarePressed"
            android:scaleType="fitCenter"
            android:tag="2,2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/onlinecell21"
            app:layout_constraintTop_toBottomOf="@id/onlinecell12"
            app:layout_constraintBottom_toBottomOf="parent"
            android:contentDescription="@string/game_cell"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
<!--    </GridLayout>-->

    <TextView
        android:id="@+id/online_status_text_view"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@drawable/speech_bubble_red_border_stars_200"
        android:text="X"
        android:textAlignment="center"
        android:gravity="center"
        android:fontFamily="@font/permanent_marker"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/boardContainer"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/online_new_game_button"
        android:layout_width="250dp"
        android:layout_height="150dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/comic_text_bubble_400_350"
        android:paddingEnd="@dimen/_40dp"
        android:fontFamily="@font/permanent_marker"
        android:onClick="playAgainPressed"
        android:text="@string/play_again"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="invisible"
        />


    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/chat_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintVertical_weight="1.5"
        app:layout_constraintTop_toBottomOf="@id/boardContainer"
        app:layout_constraintBottom_toBottomOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>