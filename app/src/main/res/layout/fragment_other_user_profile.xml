<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".profile.OtherUserProfileFragment"
    android:background="@drawable/bg_other_profile">

    <ImageButton
        android:id="@+id/back_button"
        android:layout_width="@dimen/_40dp"
        android:layout_height="@dimen/_40dp"
        android:src="@drawable/back_icon"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:scaleType="fitCenter"
        android:layout_margin="@dimen/_20dp"/>

    <!-- Initials symbol -->
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:background="@drawable/star"
        android:backgroundTint="@color/red"
        app:layout_constraintBottom_toBottomOf="@+id/initials_text_view"
        app:layout_constraintEnd_toEndOf="@+id/initials_text_view"
        app:layout_constraintStart_toStartOf="@+id/initials_text_view"
        app:layout_constraintTop_toTopOf="@id/initials_text_view" />

    <TextView
        android:id="@+id/initials_text_view"
        style="@style/InitialsTextView"
        android:layout_width="@dimen/_100dp"
        android:layout_height="@dimen/_100dp"
        android:layout_marginTop="40dp"
        android:text="sm"
        android:textSize="50sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Username and rating -->
    <TextView
        android:id="@+id/username_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/username_rating"
        android:background="@drawable/cell_empty"
        android:padding="@dimen/_12dp"
        android:fontFamily="@font/bangers"
        android:letterSpacing="0.1"
        android:textColor="@color/red"
        android:shadowColor="@color/black"
        android:shadowDx="4"
        android:shadowDy="4"
        android:shadowRadius="8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/_12dp"
        android:textStyle="bold"
        android:textSize="@dimen/profile_text"
        app:layout_constraintTop_toBottomOf="@id/initials_text_view"/>

    <!-- Box of boxes -->
    <!-- Adjust margin between boxes in @dimen/profile_box_margin-->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="@dimen/_12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/username_text_view">

        <!-- Streaks -->
        <LinearLayout
            android:id="@+id/streak_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.5">

            <TextView
                android:id="@+id/current_streak_text_view"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:layout_marginEnd="@dimen/profile_box_margin"
                android:background="@drawable/cell_empty"
                android:text="@string/current_streak"
                android:textAlignment="center"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:textSize="@dimen/profile_text"
                android:fontFamily="@font/comic_neue_bold_italic"
                android:padding="@dimen/_12dp" />

            <TextView
                android:id="@+id/max_streak_text_view"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/cell_empty"
                android:text="@string/max_streak"
                android:gravity="center"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:textSize="@dimen/profile_text"
                android:fontFamily="@font/comic_neue_bold_italic"
                android:padding="@dimen/_12dp"/>

        </LinearLayout>

        <!-- Won games container -->
        <LinearLayout
            android:id="@+id/won_games_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:layout_marginTop="@dimen/profile_box_margin">

            <TextView
                android:id="@+id/won_games_text_view"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/profile_box_margin"
                android:background="@drawable/cell_empty"
                android:fontFamily="@font/comic_neue_bold_italic"
                android:padding="16dp"
                android:gravity="center"
                android:textColor="@color/black"
                android:text="@string/won_games"
                android:textSize="@dimen/profile_text"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/won_games_number_text_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@drawable/cell_empty"
                android:fontFamily="@font/comic_neue_bold_italic"
                android:gravity="center"
                android:text="1"
                android:textSize="@dimen/profile_text"
                android:textStyle="bold"
                android:textColor="@color/black"/>

        </LinearLayout>

        <!-- Lost games container -->
        <LinearLayout
            android:id="@+id/lost_games_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/profile_box_margin"
            android:layout_weight="1">

            <TextView
                android:id="@+id/lost_games_text_view"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:layout_marginEnd="@dimen/profile_box_margin"
                android:background="@drawable/cell_empty"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:fontFamily="@font/comic_neue_bold_italic"
                android:paddingStart="@dimen/_40dp"
                android:paddingEnd="@dimen/_40dp"
                android:text="@string/lost_games"
                android:textSize="@dimen/profile_text"
                android:textStyle="bold"
                android:textColor="@color/black"/>

            <TextView
                android:id="@+id/lost_games_number_text_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@drawable/cell_empty"
                android:fontFamily="@font/comic_neue_bold_italic"
                android:gravity="center"
                android:text="1"
                android:textSize="@dimen/profile_text"
                android:textStyle="bold"
                android:textColor="@color/black"/>

        </LinearLayout>

        <!-- Total games container -->
        <LinearLayout
            android:id="@+id/total_games_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/profile_box_margin"
            android:layout_weight="1">

            <TextView
                android:id="@+id/total_games_text_view"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:layout_marginEnd="@dimen/profile_box_margin"
                android:background="@drawable/cell_empty"
                android:padding="16dp"
                android:gravity="center"
                android:fontFamily="@font/comic_neue_bold_italic"
                android:text="@string/total_games"
                android:textSize="@dimen/profile_text"
                android:textStyle="bold"
                android:textColor="@color/black"/>

            <TextView
                android:id="@+id/total_games_number_text_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@drawable/cell_empty"
                android:fontFamily="@font/comic_neue_bold_italic"
                android:gravity="center"
                android:text="1"
                android:textSize="@dimen/profile_text"
                android:textStyle="bold"
                android:textColor="@color/black"/>

        </LinearLayout>
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/play_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_button_red"
        android:fontFamily="@font/bangers"
        android:paddingBottom="4dp"
        android:shadowColor="@color/black"
        android:shadowDx="4"
        android:shadowDy="4"
        android:shadowRadius="8"
        android:text="@string/play"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/add_friend_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_20dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_button_green"
        android:fontFamily="@font/bangers"
        android:paddingBottom="4dp"
        android:paddingEnd="@dimen/_8dp"
        android:paddingStart="@dimen/_4dp"
        android:shadowColor="@color/black"
        android:shadowDx="4"
        android:shadowDy="4"
        android:shadowRadius="8"
        android:text="@string/add_friend"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="@+id/play_button"
        app:layout_constraintStart_toStartOf="@+id/play_button"
        app:layout_constraintTop_toBottomOf="@id/play_button" />

</androidx.constraintlayout.widget.ConstraintLayout>