<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.cardview.widget.CardView
        android:id="@+id/right_chat_card_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:backgroundTint="@color/red"
        android:layout_margin="16dp"
        app:cardCornerRadius="@dimen/_20dp"
        >
        <TextView
            android:id="@+id/right_chat_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/_12dp"
            android:textColor="@android:color/white"
            android:textSize="@dimen/_16sp"
            android:text="hej hej"
            />

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/timestamp_right_chat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="14:04"
        android:layout_marginTop="@dimen/_4dp"
        android:layout_marginEnd="@dimen/_12dp"
        app:layout_constraintTop_toBottomOf="@id/right_chat_card_view"
        app:layout_constraintEnd_toEndOf="@id/right_chat_card_view"
        android:textColor="@color/black_overlay"/>

</androidx.constraintlayout.widget.ConstraintLayout>