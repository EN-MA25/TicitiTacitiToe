<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:id="@+id/username_left_chat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Username"
        android:fontFamily="@font/permanent_marker"
        android:shadowColor="@color/blue"
        android:shadowDx="4"
        android:shadowDy="4"
        android:shadowRadius="8"
        android:layout_marginTop="@dimen/_4dp"
        android:layout_marginStart="@dimen/_12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:textColor="@color/black_overlay"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/left_chat_card_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        android:backgroundTint="@color/blue"
        app:layout_constraintTop_toBottomOf="@id/username_left_chat"
        android:layout_marginHorizontal="6dp"
        app:cardCornerRadius="@dimen/_20dp">

    <TextView
        android:id="@+id/left_chat_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/speech_bubble_squere_left_100"
        android:textAlignment="center"
        android:layout_marginTop="2dp"
        android:textColor="@android:color/black"
        android:fontFamily="@font/chewy"
        android:textSize="@dimen/_16sp"
        android:text="tjenare \ntjenare"/>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/timestamp_left_chat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="14:04"
        android:fontFamily="@font/chewy"
        android:layout_marginTop="@dimen/_4dp"
        android:layout_marginStart="@dimen/_12dp"
        app:layout_constraintTop_toBottomOf="@id/left_chat_card_view"
        app:layout_constraintStart_toStartOf="@id/left_chat_card_view"
        android:textColor="@color/black_overlay"/>
</androidx.constraintlayout.widget.ConstraintLayout>