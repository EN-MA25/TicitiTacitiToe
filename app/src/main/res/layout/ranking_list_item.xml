<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    android:layout_marginVertical="@dimen/_6dp"
    android:backgroundTint="@color/light_yellow"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_margin="@dimen/_6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/star"
            android:backgroundTint="@color/red"
            app:layout_constraintTop_toTopOf="@id/initials_text_view"
            app:layout_constraintBottom_toBottomOf="@+id/initials_text_view"
            app:layout_constraintEnd_toEndOf="@+id/initials_text_view"
            app:layout_constraintStart_toStartOf="@+id/initials_text_view" />

    <TextView
        android:id="@+id/initials_text_view"
        style="@style/InitialsTextView"
        android:layout_marginStart="8dp"
        android:layout_marginTop="16dp"
        android:text="SM"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
         />

        <TextView
            android:id="@+id/username_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_20dp"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/permanent_marker"
            android:shadowColor="@color/red"
            android:shadowDx="4"
            android:shadowDy="4"
            android:shadowRadius="8"
            android:text="Username + ranking"
            android:textColor="@color/black"
            android:textSize="@dimen/_18sp"
            app:layout_constraintStart_toEndOf="@id/initials_text_view"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/win_loss_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_20dp"
            android:fontFamily="@font/comic_neue_bold_italic"
            app:layout_constraintStart_toEndOf="@id/initials_text_view"
            app:layout_constraintTop_toBottomOf="@id/username_text_view"
            android:textColor="@color/black"
            android:text="Wins/losses"/>

        <TextView
            android:id="@+id/average_time_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_20dp"
            android:fontFamily="@font/comic_neue_bold_italic"
            app:layout_constraintStart_toEndOf="@id/initials_text_view"
            app:layout_constraintTop_toBottomOf="@id/win_loss_text_view"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="@dimen/_6dp"
            android:textColor="@color/black"
            android:text="Average win time"/>

        <TextView
            android:id="@+id/average_moves_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_6dp"
            android:layout_marginBottom="@dimen/_6dp"
            android:fontFamily="@font/comic_neue_bold_italic"
            app:layout_constraintStart_toEndOf="@id/average_time_text_view"
            app:layout_constraintTop_toBottomOf="@id/win_loss_text_view"
            app:layout_constraintBottom_toBottomOf="parent"
            android:textColor="@color/black"
            android:text="Average moves to win"/>

        <TextView
            android:id="@+id/ranking_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="@dimen/_30sp"
            android:fontFamily="@font/comic_neue_bold_italic"
            android:shadowColor="@color/white"
            android:shadowDx="8"
            android:shadowDy="8"
            android:shadowRadius="12"
            android:layout_marginHorizontal="@dimen/_6dp"
            android:layout_marginBottom="@dimen/_6dp"
            app:layout_constraintStart_toEndOf="@id/average_moves_text_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:textColor="@color/black"
            android:text="@string/_1"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>