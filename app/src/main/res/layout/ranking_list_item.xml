<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    android:layout_marginVertical="@dimen/_6dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_margin="@dimen/_6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
    <TextView
        android:id="@+id/initials_text_view"
        android:layout_width="@dimen/_40dp"
        android:layout_height="@dimen/_40dp"
        android:background="@drawable/circle_image"
        android:gravity="center"
        android:textAllCaps="true"
        android:textSize="20sp"
        android:textStyle="bold"
        android:text="U"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
         />

    <TextView
        android:id="@+id/username_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_20dp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/initials_text_view"
        app:layout_constraintTop_toTopOf="parent"
        android:textColor="@color/black"
        android:text="Username"/>

        <TextView
            android:id="@+id/win_loss_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_20dp"
            app:layout_constraintStart_toEndOf="@id/initials_text_view"
            app:layout_constraintTop_toBottomOf="@id/username_text_view"
            android:textColor="@color/black"
            android:text="Wins/losses"/>

        <TextView
            android:id="@+id/average_time_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_20dp"
            app:layout_constraintStart_toEndOf="@id/initials_text_view"
            app:layout_constraintTop_toBottomOf="@id/win_loss_text_view"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="@dimen/_6dp"
            android:textColor="@color/black"
            android:text="Average win time"/>

        <TextView
            android:id="@+id/average_moves_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_6dp"
            android:layout_marginBottom="@dimen/_6dp"
            app:layout_constraintStart_toEndOf="@id/average_time_text_view"
            app:layout_constraintTop_toBottomOf="@id/win_loss_text_view"
            app:layout_constraintBottom_toBottomOf="parent"
            android:textColor="@color/black"
            android:text="Average moves to win"/>

        <TextView
            android:id="@+id/ranking_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="@dimen/_30sp"
            android:layout_marginHorizontal="@dimen/_6dp"
            android:layout_marginBottom="@dimen/_6dp"
            app:layout_constraintStart_toEndOf="@id/average_moves_text_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:textColor="@color/black"
            android:text="@string/_1"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>