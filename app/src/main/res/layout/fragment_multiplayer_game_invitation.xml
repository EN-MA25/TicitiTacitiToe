<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_gradient_red_orange_w_yellow_lines"
    tools:context=".game.invitations.ui.MultiplayerGameInvitationFragment">

    <TextView
        android:id="@+id/invitation_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_20dp"
        android:background="@color/red"
        android:fontFamily="@font/permanent_marker"
        android:paddingStart="@dimen/_8dp"
        android:paddingEnd="@dimen/_8dp"
        android:text="@string/invitation_text"
        android:textAlignment="center"
        android:textColor="@color/yellow"
        android:textSize="@dimen/_18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/accept_invite_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/start_game"
        android:background="@drawable/bg_button_green"
        android:shadowColor="@color/black"
        android:shadowDx="4"
        android:shadowDy="4"
        android:shadowRadius="8"
        android:textSize="22sp"
        android:fontFamily="@font/bangers"
        android:textColor="@color/white"
        android:paddingTop="6dp"
        android:paddingBottom="12dp"
        android:paddingHorizontal="@dimen/_18dp"
        android:letterSpacing="0.1"
        android:layout_margin="@dimen/_20dp"
        app:layout_constraintTop_toBottomOf="@id/invitation_text_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/decline_invite_button"
        app:layout_constraintBottom_toBottomOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/decline_invite_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/decline"
        android:background="@drawable/bg_button_red"
        android:shadowColor="@color/black"
        android:shadowDx="4"
        android:shadowDy="4"
        android:shadowRadius="8"
        android:textSize="22sp"
        android:fontFamily="@font/bangers"
        android:textColor="@color/white"
        android:paddingTop="6dp"
        android:paddingBottom="12dp"
        android:paddingHorizontal="@dimen/_18dp"
        android:letterSpacing="0.1"
        android:layout_margin="@dimen/_20dp"
        app:layout_constraintTop_toBottomOf="@id/invitation_text_view"
        app:layout_constraintStart_toEndOf="@id/accept_invite_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>